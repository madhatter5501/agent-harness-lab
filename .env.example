# Compose uses this address to reach LM Studio on the host.
MODEL_BASE_URL=http://host.docker.internal:1234/v1
MODEL_NAME=hermes-3-llama-3.1-8b
MODEL_PROTOCOL=chat
# json = schema-constrained decisions for Hermes; native = native tool_calls.
DECISION_FORMAT=json
# Optional: configure a smaller local model for the utility classification step.
UTILITY_MODEL_NAME=hermes-3-llama-3.1-8b
MODEL_API_KEY=
# Educational demo only. Replace before exposing beyond your own computer.
DEMO_JWT_SECRET=local-lab-only-change-before-sharing-123456789
